# ==============================================================================
# BẢN MẪU BIẾN MÔI TRƯỜNG CHO PILOT / STAGING (KHÔNG CHỨA MẬT KHẨU THẬT)
# Hướng dẫn: Sao chép tệp này thành '.env' (đã chặn bởi .gitignore) trước khi chạy.
# ==============================================================================
APP_VERSION=v1.2.4
PILOT_DOMAIN=pilot.aiot-lab.local
LOG_LEVEL=INFO
MODEL_VERSION=v1.2.4

# Khi chạy Docker Compose Pilot, mật khẩu được nạp từ tệp Secrets (/run/secrets/...)
AI_API_KEY_FILE=/run/secrets/api_secret_key
# Chỉ dùng giá trị giả lập bên dưới khi chạy thử cục bộ không qua Docker
AI_API_KEY=change-me-in-local-env-only